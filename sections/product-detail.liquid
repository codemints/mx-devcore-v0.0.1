{%- liquid
  assign s = section.settings
  assign resource = settings.product | default: product
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-bg-color: var(--c-{{ s.bg_color }});
    --section-bg-opacity: {{ s.bg_opacity | times: 0.01 }};

    --gap-x: {{ s.gap_x }}px;
    --gap-y: {{ s.gap_y }}px;
  }
{%- endstyle -%}

<div {% if s.anchor_id != blank %}id="{{ s.anchor_id }}" {% endif %}class="section__wrapper">
  <div class="{% if s.bg_size == 'full' %} background{% endif %}">
    <div class="section__container container">
      <div class="section__content content{% if s.bg_size == 'contained' %} background{% endif %}">

        <div class="section__main flex {{ s.layout_sm }} {{ s.layout_lg }} gap-x-(--gap-x) gap-y-(--gap-y)">
          <div class="pdp-carousel h-400 w-full bg-teal-500">

          </div>

          <div class="pdp-detail h-400 w-full bg-fuchsia-500">

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- schema -%}
  {
    "name": "Product Detail",
    "tag": "section",
    "class": "section__product-detail",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "text",
        "id": "anchor_id",
        "label": "Anchor ID"
      },
      {
        "type": "select",
        "id": "bg_color",
        "label": "Background color",
        "default": "default",
        "options": [
          { "value": "default", "label": "Default" },
          { "value": "midnight", "label": "Midnight" },
          { "value": "cobalt", "label": "Cobalt" },
          { "value": "seafoam", "label": "Seafoam" },
          { "value": "ivory", "label": "Ivory" },
          { "value": "stone", "label": "Stone" },
        ]
      },
      {
        "type": "range",
        "id": "bg_opacity",
        "label": "Background opacity",
        "default": 100,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ section.settings.bg_color != 'default' }}"
      },
      {
        "type": "select",
        "id": "bg_size",
        "label": "Background size",
        "default": "full",
        "options": [
          { "value": "full", "label": "Full" },
          { "value": "contained", "label": "Contained" }
        ],
        "visible_if": "{{ section.settings.bg_color != 'default' }}"
      },
      {
        "type": "header",
        "content": "Product Settings"
      },
      {
        "type": "product",
        "id": "product",
        "label": "Product",
        "info": "Required when used outside of the product template."
      },
      {
        "type": "checkbox",
        "id": "use_variant",
        "label": "Use product variant",
        "default": false,
        "visible_if": "{{ section.settings.product != blank }}"
      },
      {
        "type": "text",
        "id": "variant_id",
        "label": "Variant ID",
        "visible_if": "{{ section.settings.product != blank and section.settings.use_variant == true }}"
      },
      {
        "type": "header",
        "content": "Layout Settings"
      },
      {
        "type": "select",
        "id": "layout_sm",
        "label": "First in layout",
        "default": "flex-col",
        "options": [
          { "value": "flex-col", "label": "Slider" },
          { "value": "flex-col-reverse", "label": "Detail" }
        ]
      },
      {
        "type": "range",
        "id": "gap_sm",
        "label": "Gap",
        "default": 40,
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "enable_layout_lg",
        "label": "Show custom layout settings for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "layout_lg",
        "label": "First on desktop",
        "default": "lg:flex-row",
        "options": [
          { "value": "lg:flex-row", "label": "Slider" },
          { "value": "lg:flex-row-reverse", "label": "Detail" }
        ],
        "visible_if": "{{ section.settings.enable_layout_lg == true }}"
      },
      {
        "type": "range",
        "id": "gap_x",
        "label": "Gap on desktop",
        "default": 80,
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "visible_if": "{{ section.settings.enable_layout_lg == true }}"
      },
      {
        "type": "range",
        "id": "basis_lg",
        "label": "Product detail column width",
        "default": 50,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "visible_if": "{{ section.settings.enable_layout_lg == true }}"
      },
    ],
    "blocks": [

    ],
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "presets": [
      {
        "name": "Product Detail",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}