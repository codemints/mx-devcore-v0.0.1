{%- liquid
  assign s = section.settings
  assign resource = settings.product | default: product
-%}

<div {% if s.section_id != blank %}id="{{ s.section_id }}" {% endif %}class="section__wrapper">
  <div class="{% if s.bg_size == 'full' %} background{% endif %}">
    <div class="section__container container">
      <div class="section__content content{% if s.bg_size == 'contained' %} background{% endif %}">
        <div class="section__header"></div>

        <div class="section__main"></div>
      </div>
    </div>
  </div>
</div>

{%- schema -%}
  {
    "name": "Product Detail",
    "tag": "section",
    "class": "section__product-detail",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "select",
        "id": "bg_color",
        "label": "Background color",
        "default": "default",
        "options": [
          { "value": "default", "label": "Default" },
          { "value": "midnight", "label": "Midnight" },
          { "value": "cobalt", "label": "Cobalt" },
          { "value": "seafoam", "label": "Seafoam" },
          { "value": "ivory", "label": "Ivory" },
          { "value": "stone", "label": "Stone" },
        ]
      },
      {
        "type": "range",
        "id": "bg_opacity",
        "label": "Background opacity",
        "default": 100,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%"
      },
      {
        "type": "select",
        "id": "bg_size",
        "label": "Background size",
        "default": "full",
        "options": [
          { "value": "full", "label": "Full" },
          { "value": "contained", "label": "Contained" }
        ]
      },
      {
        "type": "product",
        "id": "product",
        "label": "Product",
        "info": "Only required when used outside of the product template."
      }
    ],
    "blocks": [

    ],
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "presets": [
      {
        "name": "Product Detail",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}