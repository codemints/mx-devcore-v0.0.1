<div class="header__inner bg-gray-200 text-gray-500 px-(--hdr-px)">
  <div class="header__logo py-(--hdr-py)">

  </div>

  <div class="header__navigation">
    <ul>
      {%- for link in settings.menu_primary.links -%}
        <li>
          <a href="{{ link.url }}">
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="header__actions py-(--hdr-py)">

  </div>
</div>

{%- schema -%}
  {
    "name": "Header Primary",
    "tag": "header",
    "class": "section__header",
    "settings": [],
    "blocks": []
  }
{%- endschema -%}