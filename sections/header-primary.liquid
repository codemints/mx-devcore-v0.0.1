<div class="header__inner text-(length:--hdr-fz) bg-gray-200 text-gray-500 px-(--hdr-px)">
  <div class="header__logo py-(--hdr-py)">

  </div>

  <div class="header__navigation">
    <ul class="flex items-center">
      {%- for link in settings.menu_primary.links -%}
        <li class="leading-none">
          <a href="{{ link.url }}">
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="header__actions py-(--hdr-py)">

  </div>
</div>

{%- schema -%}
  {
    "name": "Header Primary",
    "tag": "header",
    "class": "section__header",
    "settings": [],
    "blocks": []
  }
{%- endschema -%}