{%- comment -%} STATIC BLOCKS {%- endcomment -%}
{%- comment -%} END {%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign source = s.collection | default: collection
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {}
{%- endstyle -%}

<div outer>
  <div class="block-offset" inner>
    <!-- conditionally rendered -->
    <div background-full></div>

    <div class="inline-offset inline-space block-space page-max" wrapper>
      <!-- conditionally rendered -->
      <div background-contained></div>

      <div content>
        <!-- shoppify liquid from blocks and settings -->
        <div section-title></div> <!-- example -->
        <div section-grid></div> <!-- example -->
      </div>
    </div>
  </div>
</div>

<div class="collection__grid grid grid-cols-2 lg:grid-cols-4 gap-x-6 lg:gap-x-10 gap-y-12 lg:gap-y-15">
  {%- for resource in source.products -%}
    {%- content_for 'block',
      type: '_card-product-static',
      id: 'collection-grid-item',
      closest.product: resource
    -%}
  {%- endfor -%}
</div>

{%- schema -%}
  {
    "name": "Collection Grid",
    "tag": "section",
    "class": "section__collection-grid",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection",
        "info": "Only required when used outside of the collection template."
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Collection Grid",
        "settings": {},
        "blocks": [],
        "category": "Collection"
      }
    ]
  }
{%- endschema -%}