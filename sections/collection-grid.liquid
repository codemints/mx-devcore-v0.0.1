{%- comment -%} STATIC BLOCKS {%- endcomment -%}
{%- comment -%} END {%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign source = s.collection | default: collection
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {}
{%- endstyle -%}

<div>
  {%- for resource in source.products -%}
    {%- content_for 'block', type: '_card-product', id: 'collection-grid-item'%}
  {%- endfor -%}
</div>

{%- schema -%}
  {
    "name": "Collection Grid",
    "tag": "section",
    "class": "section__collection-grid",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection",
        "info": "Only required when used outside of the collection template."
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Collection Grid",
        "settings": {},
        "blocks": [],
        "category": "Collection"
      }
    ]
  }
{%- endschema -%}