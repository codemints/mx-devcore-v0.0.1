{%- liquid
  assign og_title = page_title | escape
  assign og_url = canonical_url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name | escape
  assign og_image = nil
  assign og_image_width = nil
  assign og_image_height = nil
  assign og_image_alt = shop.name

  if settings.share_image
    assign og_image = settings.share_image | image_url: width: 1200
    assign og_image_width = 1200
    assign og_image_height = settings.share_image.height | times: 1200 | divided_by: settings.share_image.width
    assign og_image_alt = settings.share_image.alt | default: shop.name
  endif
-%}

{% comment %} Template-specific overrides {% endcomment %}
{%- liquid
  case request.page_type
    when 'product'
      assign og_title = product.title | strip_html | escape
      assign og_type = 'product'
      assign og_description = product.description | strip_html | truncate: 200 | escape

      if product.featured_image
        assign og_image = product.featured_image | image_url: width: 1200
        assign og_image_width = 1200
        assign og_image_height = product.featured_image.height | times: 1200 | divided_by: product.featured_image.width
        assign og_image_alt = product.featured_image.alt | default: product.title | escape
      endif

    when 'article'
      assign og_title = article.title | strip_html | escape
      assign og_type = 'article'
      assign og_description = article.excerpt_or_content | strip_html | truncate: 200 | escape

      if article.image
        assign og_image = article.image | image_url: width: 1200
        assign og_image_width = 1200
        assign og_image_height = article.image.height | times: 1200 | divided_by: article.image.width
        assign og_image_alt = article.image.alt | default: article.title | escape
      endif

    when 'collection'
      assign og_title = collection.title | strip_html | escape
      assign og_type = 'product.group'
      assign og_description = collection.description | strip_html | truncate: 200 | default: og_description

      if collection.image
        assign og_image = collection.image | image_url: width: 1200
        assign og_image_width = 1200
        assign og_image_height = collection.image.height | times: 1200 | divided_by: collection.image.width
        assign og_image_alt = collection.image.alt | default: collection.title | escape
      endif

    when 'blog'
      assign og_title = blog.title | strip_html | escape
      assign og_type = 'blog'

    when 'password'
      assign og_title = shop.name
      assign og_url = shop.url
      assign og_description = shop.description | default: shop.name | escape
  endcase
-%}

{% comment %} Open Graph {% endcomment %}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if og_image -%}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:alt" content="{{ og_image_alt }}">
  {%- if og_image_width -%}
    <meta property="og:image:width" content="{{ og_image_width }}">
  {%- endif -%}
  {%- if og_image_height -%}
    <meta property="og:image:height" content="{{ og_image_height }}">
  {%- endif -%}
{%- endif -%}

{% comment %} Product-specific OG tags {% endcomment %}
{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{{ product.available | replace: 'true', 'instock' | replace: 'false', 'oos' }}">
  {%- if product.vendor != blank -%}
    <meta property="product:brand" content="{{ product.vendor }}">
  {%- endif -%}
{%- endif -%}

{% comment %} Article-specific OG tags {% endcomment %}
{%- if request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  <meta property="article:author" content="{{ article.author }}">
  {%- for tag in article.tags -%}
    <meta property="article:tag" content="{{ tag }}">
  {%- endfor -%}
{%- endif -%}

{% comment %} Additional product images for OG (2nd and 3rd) {% endcomment %}
{%- if request.page_type == 'product' and product.media.size > 1 -%}
  {%- for media in product.media offset: 1 limit: 2 -%}
    {%- if media.media_type == 'image' -%}
      <meta property="og:image" content="{{ media | image_url: width: 1200 }}">
      <meta property="og:image:alt" content="{{ media.alt | default: product.title | escape }}">
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% comment %} Twitter Card {% endcomment %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">

{%- if og_image -%}
  <meta name="twitter:image" content="{{ og_image }}">
  <meta name="twitter:image:alt" content="{{ og_image_alt }}">
{%- endif -%}
