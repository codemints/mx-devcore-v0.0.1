<script>
  window.Theme = window.Theme || {}

  Theme.routes = {
    cart: '{{ routes.cart_url }}',
    cartAdd: '{{ routes.cart_add_url }}.js',
    cartChange: '{{ routes.cart_change_url }}.js',
    cartUpdate: '{{ routes.cart_update_url }}.js',
    cartClear: '{{ routes.cart_clear_url }}.js',
    search: '{{ routes.search_url }}',
    predictiveSearch: '{{ routes.predictive_search_url }}',
    productRecommendations: '{{ routes.product_recommendations_url }}',
    allProductsCollection: '{{ routes.all_products_collection_url }}',
  }

  Theme.money = {
    format: {{ shop.money_format | json }},
    formatWithCurrency: {{ shop.money_with_currency_format | json }},
    currency: {{ cart.currency.iso_code | json }},
  }

  Theme.cart = {{ cart | json }}

  Theme.settings = {}

  Theme.locale = {{ request.locale.iso_code | json }}

  Theme.strings = {
    cart: {},
    accessibility: {},
  }
</script>