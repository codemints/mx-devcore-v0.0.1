<off-canvas
  id="cart-drawer"
  class="fixed inset-0 isolate z-(--cart-z-index)"
  data-offcanvas-wrapper
  data-offcanvas-position="{{ settings.cart_drawer_position }}"
  data-offcanvas-backdrop="true"
  data-offcanvas-scroll-lock="true"
  data-offcanvas-click-outside="true"
  data-offcanvas-keyboard="true"
>
  <div class="absolute inset-0 bg-(--cart-backdrop-background)" data-offcanvas-backdrop></div>

  <div class=" absolute {{ settings.cart_drawer_position }}" data-offcanvas-element>

  </div>
</off-canvas>