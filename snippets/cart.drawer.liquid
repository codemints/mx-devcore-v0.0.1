<off-canvas
  id="cart-drawer"
  class="fixed inset-0 isolate z-(--cart-z-index)"
  data-offcanvas-wrapper
  data-offcanvas-position="{{ settings.cart_drawer_position }}"
  data-offcanvas-backdrop="true"
  data-offcanvas-scroll="false"
  data-offcanvas-static="false"
  data-offcanvas-keyboard="true"
>
  <div class="absolute inset-0 bg-(--cart-backdrop-background)" data-offcanvas-backdrop></div>

  <div class="absolute top-(--cart-drawer-top) right-0 w-full lg:w-(--cart-drawer-width) h-(--cart-drawer-height)" data-offcanvas-drawer>
    <div class="cart-drawer__inner w-full h-full bg-gray-200">
      <cart
        data-cart-content="drawer"
      >
        {%- render 'cart.content' -%}
      </cart>
    </div>
  </div>
</off-canvas>