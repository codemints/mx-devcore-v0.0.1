<a
  href="{{ routes.cart_url }}"
  class="inline-block w-full h-full **:pointer-events-none{% if settings.cart_count_visible == true %} relative{% endif %}"
  {% if settings.cart_type == 'drawer' %}
    {% if settings.cart_drawer_type == 'overlay' %}
      mx-cart-open
    {% elsif settings.cart_drawer_type == 'underlay' %}
      mx-cart-toggle
    {%- endif -%}
  {% endif %}
>
  {%- if settings.cart_count_visible == true -%}
    <span class="block">
  {%- endif -%}

  {%- render 'icons.theme', icon: 'cart' -%}

  {%- if settings.cart_count_visible == true -%}
    </span>

    <span class="block absolute{% if settings.cart_count_hide == true and cart.item_count == 0 %} hidden{% endif %}">{{ cart.item_count }}</span>
  {%- endif -%}
</a>