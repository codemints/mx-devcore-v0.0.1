<a
  href="{{ routes.cart_url }}"
  class="inline-block w-full h-full **:pointer-events-none{% if settings.cart_count_visible == true %} relative{% endif %}"
  {% if settings.cart_type == 'drawer' %}
    role="button"
    aria-expanded="false"
    aria-controls="cart-drawer"
    data-overlay-trigger
  {% endif %}
>
  {%- if settings.cart_count_visible == true -%}
    <span class="block">
  {%- endif -%}

  {%- render 'icons.theme', icon: 'cart' -%}

  {%- if settings.cart_count_visible == true -%}
    </span>

    <span class="flex justify-center items-center absolute top-0 right-0 w-4 aspect-square text-gray-200 text-[12px] bg-gray-700 rounded-full translate-x-1/2 -translate-y-1/2{% if settings.cart_count_hide == true and cart.item_count == 0 %} hidden{% endif %}">{{ cart.item_count }}</span>
  {%- endif -%}
</a>