{%- comment -%}
  This snippet is used to render slides for the product media carousel.

  Accepts:
    - prefix: {String} the prefix for the type of sider to render
    - images: {Array} the product.media array
    - image_fit: {String} the object-fit class for images
    - arrows_classlist: {String} the classlist for arrows to pass to the slider.ui.liquid
    - pagination_classlist: {String} the classlist for pagination to pass to the slider.ui.liquid
{%- endcomment -%}

{%- liquid
-%}

{%- capture image_classlist -%}
  w-full h-full {{ image_fit }}
{%- endcapture -%}

{%- capture video_classlist -%}
  {{ image_classlist }}
{%- endcapture -%}

{%- capture slides -%}
  {% for item in resource.media %}
    {%- capture media_type -%}
      {%- render 'u.media-type', source: item -%}
    {%- endcapture -%}

    <li class="splide__slide" ref="[]{{ prefix }}-slide">
      <div class="slider-image__wrapper relative after:block after:pb-(--aspect-pb)">
        <div class="slider-image__inner absolute w-full h-full">
          {%- case media_type -%}
            {%- when 'image' -%}
              {{ item
                | image_url: width: item.width
                | image_tag: class: image_classlist
              }}
            {%- when 'video' -%}
              {{ item
                | video_tag: class: video_classlist
              }}
            {%- when 'external_video' -%}
          {%- endcase -%}
        </div>
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- render 'slider.ui',
  prefix: prefix,
  slides_html: slides,
  arrows_classlist: arrows_classlist
  pagination_classlist: pagination_classlist
-%}