{% liquid
  assign entry = entry | default: vite-tag
  assign path = entry | replace: '@/', '../../app/' | replace: '@css/', '../../app/css/' | replace: '@js/', '../../app/js/' | replace: '@core/', '../../app/js/core/' | replace: '@lib/', '../../app/js/lib/' | replace: '~/', '../'
%}
{% if path == "/js/theme-core.js" or path == "../../js/theme-core.js" %}
