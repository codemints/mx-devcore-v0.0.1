/* Font Families */
--font-family-display: 'Archivo', sans-serif;
--font-variation-display: "wdth" 115;

--font-family-heading: 'Space Grotesk', sans-serif;

--font-family-body: 'Inter', sans-serif;
--font-variation-body: "opsz" 16;

/* Font Weights — Display */
--weight-display: 800;

/* Font Weights — Heading */
--weight-h1-2: 700;
--weight-h3-4: 600;
--weight-h5-6: 500;

/* Font Weights — Body */
--weight-body: 400;
--weight-label: 500;

/* Font Settings - Display */
--font-size-d1: 60px;
--leading-d1: 1.05;
--tracking-d1: -0.025em;

--font-size-d2: 48px;
--leading-d2: 1.05;
--tracking-d2: -0.02em;

--font-size-d3: 40px;
--leading-d3: 1.1;
--tracking-d3: -0.015em;

/* Font Settings - Heading
--font-size-h1: 36px;
--leading-h1: 1.15;
--tracking-h1: -0.015em;

--font-size-h2: 32px;
--leading-h2: 1.2;
--tracking-h2: -0.01em;

--font-size-h3: 28px;
--leading-h3: 1.25;
--tracking-h3: -0.005em;

--font-size-h4: 24px;
--leading-h4: 1.3;
--tracking-h4: -0.005em;

--font-size-h5: 20px;
--leading-h5: 1.35;
--tracking-h5: 0em;

--font-size-h6: 18px;
--leading-h6: 1.4;
--tracking-h6: 0em;

/* Font Settings - Body */
--font-size-b1: 18px;
--leading-b1: 1.55;
--tracking-b1: 0em;

--font-size-b2: 16px;
--leading-b2: 1.6;
--tracking-b2: 0.005em;

--font-size-b3: 14px;
--leading-b3: 1.65;
--tracking-b3: 0.01em;

/* Font Settings - Label */
--font-size-label: 12px;
--leading-label: 1.45;
--tracking-label: 0.025em;

/* Resoponsive Font Settings */
@media only screen and (min-width: 1024px) {
  --font-size-d1: 120px;
  --leading-d1: 1.0;
  --tracking-d1: -0.03em;

  --font-size-d2: 96px;
  --leading-d2: 1.0;
  --tracking-d2: -0.025em;

  --font-size-d3: 72px;
  --leading-d3: 1.05;
  --tracking-d3: -0.02em;

  --font-size-h1: 60px;
  --leading-h1: 1.1;
  --tracking-h1: -0.02em;

  --font-size-h2: 48px;
  --leading-h2: 1.15;
  --tracking-h2: -0.015em;

  --font-size-h3: 40px;
  --leading-h3: 1.2;
  --tracking-h3: -0.01em;

  --font-size-h4: 32px;
  --leading-h4: 1.25;
  --tracking-h4: -0.01em;

  --font-size-h5: 24px;
  --leading-h5: 1.3;
  --tracking-h5: -0.005em;

  --font-size-h6: 20px;
  --leading-h6: 1.35;
  --tracking-h6: 0em;

  --font-size-b1: 20px;
  --leading-b1: 1.5;
  --tracking-b1: 0em;

  --font-size-b2: 18px;
  --leading-b2: 1.55;
  --tracking-b2: 0em;

  --font-size-b3: 16px;
  --leading-b3: 1.6;
  --tracking-b3: 0.005em;

  --font-size-label: 14px;
  --leading-label: 1.4;
  --tracking-label: 0.02em;
}