{%- liquid
  assign height = '100%'
  assign top = 0

  if settings.cart_drawer_position == 'under'
    assign height = 'calc(100dvh - var(--header-height))'
    assign top = 'var(--header-height)'
  endif
-%}

--cart-drawer-width: {{ settings.cart_drawer_width }}px;
--cart-backdrop-color: #000;
--cart-backdrop-opacity: 0.5;
--cart-backdrop-background: oklch(from var(--cart-backdrop-color) l c h / var(--cart-backdrop-opacity, 1));
--cart-drawer-height: {{ height }};
--cart-drawer-top: {{ top }};
--cart-z-index: 2;