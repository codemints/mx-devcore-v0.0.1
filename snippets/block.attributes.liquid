{%- liquid
  assign attributes = null | sort
  assign sid = section.id
  assign bid = block.id
  assign attrs = block.shopify_attributes

  assign prefix = 'theme-block__'

  assign id_parts = bid | split: '__'
  assign unique = id_parts | first
  assign name = id_parts | last

  assign block_id = sid | append: '--' | append: bid | append: '__'
  assign id = prefix | append: block_id | append: unique
  assign classname = prefix | append: name

  assign sorted_id = id | sort
  assign sorted_classname = classname | sort
  assign sorted_attrs = attrs | sort

  assign attributes = attributes | concat: sorted_id
  assign attributes = attributes | concat: sorted_classname
  assign attributes = attributes | concat: sorted_attrs

  assign array = null | sort
  assign a = 'a' | sort
  assign b = 'b' | sort
  assign c = 'c' | sort


  assign array = array | concat: a
  assign array = array | concat: b
  assign array = array | concat: c
-%}

{{ array }}