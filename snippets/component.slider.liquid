{%- comment -%}
  Reusable Splide slider wrapper.

  Accepts:
    - prefix: {String}  Ref prefix for element targeting (default: 'slider')
    - variation: {String}  CSS variant identifier (default: 'default')
    - slides: {String}  Pre-rendered slide <li> elements
    - arrows_markup: {String}  Custom arrow markup; ignored if has_arrows is false
    - has_arrows: {Boolean} Show arrow controls (default: false)
    - has_pagination: {Boolean} Show pagination dots (default: false)

  Usage:
    {%- render 'component.slider',
      prefix: 'navigation',
      variation: 'thumbnail',
      slides: slide_markup,
      arrows: '',
      has_arrows: true
      has_pagination: false
    -%}
{%- endcomment -%}

{%- liquid
  assign prefix = prefix | default: 'main'
  assign variation = variation | default: 'default'
  assign has_arrows = has_arrows | default: false
  assign has_pagination = has_pagination | default: false
-%}

<div class="splide" ref="{{ prefix }}-slider-ui" data-custom-variant="{{ variation }}">
  <div class="splide__track" ref="{{ prefix }}-slider-track">
    <ul class="splide__list" ref="{{ prefix }}-slider-list">
      {{ slides }}
    </ul>
  </div>

  {%- if has_arrows -%}
    <div class="splide__arrows" ref="{{ prefix }}-slider-arrows">
      {{ arrows_markup }}
    </div>
  {%- endif -%}

  {%- if has_pagination -%}
    <ul class="splide__pagination" ref="{{ prefix }}-slider-pagination"></ul>
  {%- endif -%}
</div>