{%- comment -%}
  This snippet is used to return the type of media for a source. This can be an image_picker, a video, or a video_url setting type.

  Accepts:
    - source: {Object} The setting object for the source

  Usage:
    {%- render 'utility.media-type', source: section.settings.image -%}

  Returns:
    - type: {String} The media type: image, video, youtube, or vimeo
{%- endcomment -%}

{%- liquid
  assign type = null

  if source.type != blank
    assign type = source.type
  else
    assign type = source.media_type
  endif
-%}

{{ type | strip_newlines | strip }}