--theme-mt: 0;
--theme-mb: 0;

--theme-ml: 10px;
--theme-mr: 10px;

--theme-pt: 40px;
--theme-pb: 40px;
--theme-pl: 20px;
--theme-pr: 20px;

--theme-page-max: 1536px;

--theme-gutter-pl: calc(var(--theme-pl) * -1);
--theme-gutter-pr: calc(var(--theme-pr) * -1);
--theme-gutter-ml: calc(var(--theme-ml) * -1);
--theme-gutter-mr: calc(var(--theme-mr) * -1);

@media only screen and (min-width: 1024px) {
  --theme-ml: 20px;
  --theme-mr: 20px;

  --theme-pt: 80px;
  --theme-pb: 80px;
  --theme-pl: 40px;
  --theme-pr: 40px;
}