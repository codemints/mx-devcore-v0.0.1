--theme-gap-t: 0;
--theme-gap-b: 0;

--theme-inset-l: 10px;
--theme-inset-r: 10px;

--theme-pad-t: 40px;
--theme-pad-b: 40px;
--theme-pad-l: 20px;
--theme-pad-r: 20px;

--theme-page-max: 1536px;

@media only screen and (min-width: 1024px) {
  --theme-inset-l: 20px;
  --theme-inset-r: 20px;

  --theme-pad-t: 80px;
  --theme-pad-b: 80px;
  --theme-pad-l: 40px;
  --theme-pad-r: 40px;
}