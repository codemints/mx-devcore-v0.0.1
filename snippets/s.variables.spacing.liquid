--theme-gap-top: 0;
--theme-gap-bottom: 0;

--theme-inset-left: 10px;
--theme-inset-right: 10px;

--theme-pad-top: 40px;
--theme-pad-bottom: 40px;
--theme-pad-left: 20px;
--theme-pad-right: 20px;

--theme-page-max: 1536px;

@media only screen and (min-width: 1024px) {
  --theme-inset-left: 20px;
  --theme-inset-right: 20px;

  --theme-pad-top: 80px;
  --theme-pad-bottom: 80px;
  --theme-pad-left: 40px;
  --theme-pad-right: 40px;
}