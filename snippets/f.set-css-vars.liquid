<script type="module">
  const elements = {
    navbar: document.querySelector('[id$=header_primary]'),
    topbar: document.querySelector('[id$=header_banner]'),
  }

  const headerHeight = Object.entries(elements).reduce((acc, [key, val]) => {
    const h = val.offsetHeight
    document.documentElement.style.setProperty(`--${key}-height`, `${h}px`)
    return acc += h
  }, 0)

  console.log(headerHeight)
</script>