<!doctype html>

<html {% if request.design_mode %}class="shopify-design-mode" {% endif %}lang="{{ request.locale.iso_code }}" data-header-sticky>
  <head>
    <script type="module" src="{{ 'theme-critical.min.js' | asset_url }}"></script>

    {%- render 'f.set-css-vars' -%}

    {%- if settings.logo_favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.logo_favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}</title>
    {{ content_for_header }}

    {%- style -%}
      :root {
        {%- render 's.variables.type' -%}
        {%- render 's.variables.color' -%}
        {%- render 's.variables.spacing' -%}
        {%- render 's.variables.header' -%}
        {%- render 's.variables.cart' -%}

        --rte-mt: 20px;
      }
    {%- endstyle -%}

    {{ 'theme.min.css' | asset_url | stylesheet_tag }}
  </head>
  
  <body class="">
    {%- capture cart_sections -%}
      {%- sections 'group-cart' -%}
    {%- endcapture -%}

    {%- sections 'group-header' -%}

    <main>
      {%- if request.page_type == 'policy' -%}
        {%- render 'policy.content' %}
      {%- elsif request.page_type == 'cart' -%}
        {%- render 'cart.page', content: cart_sections -%}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {%- sections 'group-footer' -%}

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart.drawer', content: cart_sections -%}
    {%- endif -%}

    <script type="module" src="{{ 'theme.min.js' | asset_url }}"></script>
  </body>
</html>