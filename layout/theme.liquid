<!doctype html>

<html {% if request.design_mode %}class="shopify-design-mode" {% endif %}lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'f.set-css-vars' -%}

    {%- if settings.logo_favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.logo_favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}</title>
    {{ content_for_header }}

    {%- style -%}
      :root {
        {%- render 's.variables.color' -%}
        {%- render 's.variables.spacing' -%}
        {%- render 's.variables.header' -%}
      }
    {%- endstyle -%}

    {{ 'theme-core.min.css' | asset_url | stylesheet_tag }}
  </head>
  
  <body>
    {%- sections 'group-header' -%}

    <main>
      <h1>Testing Development Again...Again</h1>
      

      {{ content_for_layout }}
    </main>

    {%- sections 'group-footer' -%}

    {%- sections 'group-cart' -%}

    {%- if settings.enable_devmode == true and settings.enable_hot_reload == true -%}
      {%- render 'dev.theme-reload' -%}
    {%- endif -%}
  </body>
</html>