{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign sid = section.id
  assign bid = block.id

  assign prefix = 'theme-block__'

  assign id_parts = bid | split: '__'
  assign unique = id_parts | first
  assign name = id_parts | last

  assign block_id = sid | append: '--' | append: bid | append: '__'

  assign id = prefix | append: block_id | append: unique
  assign classname = prefix | append: name

  # Statically Rendered Block Props
  # theme-check-disable UndefinedObject
  assign resource = data | default: closest.product | default: product
  # theme-check-enable UndefinedObject
-%}

<div id="{{ id }}" class="{{ classname }}" {{ attrs }}>
  {%- render 'product.media-slides',
    prefix: 'thumbnail',
    images: resource.media,
    image_fit: s.image_fit,
    arrows_classlist: 'hidden',
    pagination_classlist: 'hidden'
  -%}

  <script type="application/json" ref="thumbnail-config">
    {%- liquid
      assign page_same = false
      assign gap_same = false
      assign has_breakpoints = false

      if s.per_page_sm == s.per_page_lg
        assign page_same = true
      endif

      if s.gap_sm == s.gap_lg
        assign gap_same = true
      endif

      if s.enable_settings_lg
        if page_same == false or gap_same == false
          assign has_breakpoints = true
        endif
      endif
    -%}

    {
      "perPage": {{ s.per_page_sm }},
      "gap": {{ s.gap_sm }},
      {% if has_breakpoints -%}
      "breakpoints": {
        "1024": {
          {% if page_same == false -%}
          "perPage": {{ s.per_page_lg }},
          {%- endif %}
          {% if gap_same == false %}
          "gap": {{ s.gap_lg }}
          {%- endif %}
        }
      }
      {%- endif %}
    }
  </script>
</div>

{%- schema -%}
  {
    "name": "Carousel Thumbnails",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Thumbnail Settings"
      },
      {
        "type": "range",
        "id": "per_page_sm",
        "label": "Slides per page",
        "default": 4,
        "min": 3,
        "max": 10,
        "step": 1
      },
      {
        "type": "range",
        "id": "gap_sm",
        "label": "Slide gap",
        "default": 10,
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "enable_settings_lg",
        "label": "Enable desktop settings",
        "default": false
      },
      {
        "type": "range",
        "id": "per_page_lg",
        "label": "Slides per page",
        "default": 4,
        "min": 3,
        "max": 10,
        "step": 1
      },
      {
        "type": "range",
        "id": "gap_lg",
        "label": "Slide gap",
        "default": 10,
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Image Settings"
      },
      {
        "type": "select",
        "id": "image_fit",
        "label": "Image fit",
        "default": "object-cover",
        "options": [
          { "value": "object-cover", "label": "Cover" },
          { "value": "object-contain", "label": "Contain" }
        ]
      },
      {
        "type": "select",
        "id": "aspect_sm",
        "label": "Aspect ratio",
        "default": "16:9",
        "options": [
          { "value": "custom", "label": "Custom" },
          { "value": "square", "label": "Square" },
          { "value": "fill", "label": "Fill" },
          { "value": "2:1", "label": "2:1" },
          { "value": "3:2", "label": "3:2" },
          { "value": "4:3", "label": "4:3"},
          { "value": "5:4", "label": "5:4" },
          { "value": "6:5", "label": "6:5" },
          { "value": "7:6", "label": "7:6" },
          { "value": "8:7", "label": "8:7" },
          { "value": "9:8", "label": "9:8" },
          { "value": "10:9", "label": "10:9" },
          { "value": "16:9", "label": "16:9" },
          { "value": "21:9", "label": "21:9" },
          { "value": "32:9", "label": "32:9" }
        ]
      },
      {
        "type": "text",
        "id": "custom_aspect_sm",
        "label": "Custom aspect ratio",
        "default": "16:9",
        "info": "Enter aspect ratio as 'width:height' (e.g. '16:9')",
        "visible_if": "{{ block.settings.aspect_sm == 'custom' }}"
      },
      {
        "type": "radio",
        "id": "orientation_sm",
        "label": "Media orientation",
        "default": "horizontal",
        "options": [
          { "value": "vertical", "label": "Portrait" },
          { "value": "horizontal", "label": "Landscape" }
        ],
        "visible_if": "{{ block.settings.aspect_sm != 'custom' and block.settings.aspect_sm != 'square' and block.settings.aspect_sm != 'adapt' and block.settings.aspect_sm != 'fill' }}"
      },
      {
        "type": "checkbox",
        "id": "enable_aspect_lg",
        "label": "Enable different aspect ratio for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "aspect_lg",
        "label": "Aspect ratio (desktop)",
        "default": "16:9",
        "options": [
          { "value": "custom", "label": "Custom" },
          { "value": "square", "label": "Square" },
          { "value": "fill", "label": "Fill" },
          { "value": "2:1", "label": "2:1" },
          { "value": "3:2", "label": "3:2" },
          { "value": "4:3", "label": "4:3"},
          { "value": "5:4", "label": "5:4" },
          { "value": "6:5", "label": "6:5" },
          { "value": "7:6", "label": "7:6" },
          { "value": "8:7", "label": "8:7" },
          { "value": "9:8", "label": "9:8" },
          { "value": "10:9", "label": "10:9" },
          { "value": "16:9", "label": "16:9" },
          { "value": "21:9", "label": "21:9" },
          { "value": "32:9", "label": "32:9" }
        ],
        "visible_if": "{{ block.settings.enable_aspect_lg }}"
      },
      {
        "type": "text",
        "id": "custom_aspect_lg",
        "label": "Custom aspect ratio (desktop)",
        "default": "16:9",
        "info": "Enter aspect ratio as 'width:height' (e.g. '16:9')",
        "visible_if": "{{ block.settings.enable_aspect_lg and block.settings.aspect_lg == 'custom' }}"
      },
      {
        "type": "radio",
        "id": "orientation_lg",
        "label": "Media orientation (desktop)",
        "default": "horizontal",
        "options": [
          { "value": "vertical", "label": "Portrait" },
          { "value": "horizontal", "label": "Landscape" }
        ],
        "visible_if": "{{ block.settings.enable_aspect_lg and block.settings.aspect_lg != 'custom' and block.settings.aspect_lg != 'square' and block.settings.aspect_lg != 'adapt' and block.settings.aspect_lg != 'fill' }}"
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Carousel Thumbnails",
        "settings": {},
        "blocks": [],
        "category": "Carousel"
      }
    ]
  }
{%- endschema -%}