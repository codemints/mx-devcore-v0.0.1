{%- liquid
  assign s = block.settings

  # PROP DECLARATIONS
  # theme-check-disable UndefinedObject
  assign slides = slides
  # theme-check-enable UndefinedObject
-%}

<div {% render 'block.attributes' %}>
  {%- render 'component.slider',
    prefix: 'modal',
    variation: 'modal',
    slides_html: slides
  -%}
  
  <script type="application/json" ref="modal-slider-config">
    {{ s | json }}
  </script>
</div>

{%- schema -%}
  {
    "name": "Slider Modal",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Modal Settings",
      },
      {
        "type": "checkbox",
        "id": "enable_zoom",
        "label": "Enable zoom",
        "default": true,
      },
      {
        "type": "select",
        "id": "mod_type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ],
      },
      {
        "type": "range",
        "id": "mod_per_page_sm",
        "label": "Per page",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1,
      },
      {
        "type": "range",
        "id": "mod_gap_sm",
        "label": "Gap",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
      },
      {
        "type": "checkbox",
        "id": "enable_mod_lg",
        "label": "Enable desktop settings",
        "default": false,
      },
      {
        "type": "range",
        "id": "mod_per_page_lg",
        "label": "Per page (desktop)",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1,
      },
      {
        "type": "range",
        "id": "mod_gap_lg",
        "label": "Gap (desktop)",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
      },
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Slider Modal",
        "settings": {},
        "blocks": [],
        "category": "Slider"
      }
    ]
  }
{%- endschema -%}