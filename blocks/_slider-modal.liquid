{%- liquid
  assign s = block.settings

  # PROP DECLARATIONS
  # theme-check-disable UndefinedObject
  assign slides = slides
  # theme-check-enable UndefinedObject
  
  assign arrows_sm = 'hidden'
  assign pagination_sm = 'hidden'

  assign arrows_lg = 'lg:hidden'
  assign pagination_lg = 'lg:hidden'

  if s.arrows_sm
    assign arrows_sm = 'block'
  endif

  if s.pagination_sm
    assign pagination_sm = 'block'
  endif

  if s.arrow_lg
    assign arrows_lg = 'lg:block'
  endif

  if s.pagination_lg
    assign pagination_lg = 'lg:block'
  endif
-%}

{%- capture arrows_classlist -%}
  {{ arrows_sm }}{% if s.enable_controls_lg %} {{ arrows_lg }}{% endif %}
{%- endcapture -%}

{%- capture pagination_classlist -%}
  {{ pagination_sm }}{% if s.enable_controls_lg %} {{ pagination_lg }}{% endif %}
{%- endcapture -%}

<div {% render 'block.attributes' %}>
  <overlay-ui>
    <div ref="backdrop"></div>
    
    <div ref="dialog">
      {%- render 'component.slider',
        prefix: 'modal',
        variation: 'modal',
        slides_html: slides
        arrows_classlist: arrows_classlist
        pagination_classlist: pagination_classlist
      -%}
    </div>
  </overlay-ui>
  
  <script type="application/json" ref="modal-slider-config">
    {{ s | json }}
  </script>
</div>

{%- schema -%}
  {
    "name": "Slider Modal",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Modal Settings",
      },
      {
        "type": "checkbox",
        "id": "enable_zoom",
        "label": "Enable zoom",
        "default": true,
      },
      {
        "type": "select",
        "id": "type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ],
      },
      {
        "type": "range",
        "id": "per_page_sm",
        "label": "Per page",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1,
        "visible_if": "{{ block.settings.type != 'fade' }}"
      },
      {
        "type": "range",
        "id": "gap_sm",
        "label": "Gap",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
      },
      {
        "type": "checkbox",
        "id": "enable_settings_lg",
        "label": "Enable desktop settings",
        "default": false,
      },
      {
        "type": "range",
        "id": "per_page_lg",
        "label": "Per page (desktop)",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1,
      },
      {
        "type": "range",
        "id": "gap_lg",
        "label": "Gap (desktop)",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
      },
      {
        "type": "header",
        "content": "Control Settings"
      },
      {
        "type": "select",
        "id": "arrows_sm",
        "label": "Arrow visibility",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "pagination_sm",
        "label": "Pagination visibility",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ]
      },
      {
        "type": "checkbox",
        "id": "enable_controls_lg",
        "label": "Show separate settings for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "arrows_lg",
        "label": "Arrow visibility (desktop)",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ],
        "visible_if": "{{ block.settings.enable_controls_lg }}"
      },
      {
        "type": "select",
        "id": "pagination_lg",
        "label": "Pagination visibility (desktop)",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ],
        "visible_if": "{{ block.settings.enable_controls_lg }}"
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Slider Modal",
        "settings": {},
        "blocks": [],
        "category": "Slider"
      }
    ]
  }
{%- endschema -%}