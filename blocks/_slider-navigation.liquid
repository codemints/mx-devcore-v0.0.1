{%- liquid
  assign s = block.settings
  assign sid = section.id
  assign bid = block.id

  assign prefix = 'theme-block__'

  assign id_parts = bid | split: '__'
  assign unique = id_parts | first
  assign name = id_parts | last

  assign block_id = sid | append: '--' | append: bid | append: '__'

  assign id = prefix | append: block_id | append: unique
  assign classname = prefix | append: name

  # PROP DECLARATIONS
  # theme-check-disable UndefinedObject
  assign data = data
  # theme-check-enable UndefinedObject
-%}

{%- capture slider -%}
  {%- render 'product.slides',
    resource: data,
    prefix: 'navigation'
  -%}
{%- endcapture -%}

{%- capture margin_classlist -%}
{{ s.mt_sm }}{% if s.enable_mt_lg %} {{ s.mt_lg }}{% endif %}
{%- endcapture -%}

{%- capture aspect_padding -%}
  {%- render 'u.aspect-composition',
    enable_lg: s.enable_aspect_lg,
    aspect_sm: s.aspect_sm,
    custom_sm: s.custom_aspect_sm,
    orientation_sm: s.orientation_sm,
    aspect_lg: s.aspect_lg,
    custom_lg: s.custom_aspect_lg,
    orientation_lg: s.orientation_lg,
    overlay: s.section_overlay_header
  -%}
{%- endcapture -%}

{%- comment -%} STYLES {%- endcomment -%}
  {%- style -%}
    #{{ id }} {
      {{ aspect_padding }}
    }
  {%- endstyle -%}
{%- comment -%} END {%- endcomment -%}

<div id="{{ id }}" class="{{ classname }} {{ margin_classlist }}" {{ block.shopify_attributes }}>
  {{ slider }}
  
  <script type="application/json" ref="navigation-slider-config">
    {{ s | json }}
  </script>
</div>

