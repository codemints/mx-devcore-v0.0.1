{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign sid = section.id
  assign bid = block.id

  assign prefix = 'theme-block__'

  assign id_parts = bid | split: '__'
  assign unique = id_parts | first
  assign name = id_parts | last

  assign block_id = sid | append: '--' | append: bid | append: '__'

  assign id = prefix | append: block_id | append: unique
  assign classname = prefix | append: name

  # Statically Rendered Block Props
  # theme-check-disable UndefinedObject
  assign resource = data | default: closest.product | default: product
  # theme-check-enable UndefinedObject

  assign arrows_classlist = 'hidden'
  assign pagination_classlist = 'hidden'

  if s.show_arrows
    assign arrows_classlist = s.arrows_on
  endif

  if s.show_pagination
    assign pagination_classlist = s.pagination_on
  endif
-%}

{%- comment -%} THUMBNAIL SLIDER {%- endcomment -%}
  {%- capture carousel_thumbnails -%}
    {%- content_for 'block', type: '_carousel-thumbnails', id: 'carousel_thumbnails', data: resource -%}
  {%- endcapture -%}
{%- comment -%} END {%- endcomment -%}

{%- comment -%} ASPECT RATIO {%- endcomment -%}
  {%- capture aspect_padding -%}
    {%- render 'u.aspect-composition',
      enable_lg: s.enable_aspect_lg,
      aspect_sm: s.aspect_sm,
      custom_sm: s.custom_aspect_sm,
      orientation_sm: s.orientation_sm,
      aspect_lg: s.aspect_lg,
      custom_lg: s.custom_aspect_lg,
      orientation_lg: s.orientation_lg,
      overlay: s.section_overlay_header
    -%}
  {%- endcapture -%}
{%- comment -%} END {%- endcomment -%}

{%- comment -%} STYLES {%- endcomment -%}
  {%- style -%}
    #{{ id }} {
      {{ aspect_padding }}
    }
  {%- endstyle -%}
{%- comment -%} END {%- endcomment -%}

<div id="{{ id }}" class="{{ classname }}" {{ attrs }}>
  <slider-ui>

    {%- if carousel_thumbnails != blank -%}
      {{ carousel_thumbnails }}
    {%- endif -%}

    <script type="application/json" ref="main-config">
      {%- liquid
        assign type = s.type
        assign arrows_sm = s.show_arrows
        assign pagination_sm = s.show_pagination
        assign arrows_lg = null
        assign pagination_lg = null

        if s.show_arrows
          if s.arrows_on == 'block'
            assign arrows_sm = true
            assign arrows_lg = true
          elsif s.arrows_on == 'hidden lg:block'
            assign arrows_sm = false
            assign arrows_lg = true
          elsif s.arrows_on == 'block lg:hidden'
            assign arrows_sm = true
            assign arrows_lg = false
          endif
        endif

        if s.show_pagination
          if s.pagination_on == 'block'
            assign pagination_sm = true
            assign pagination_lg = true
          elsif s.pagination_on == 'hidden lg:block'
            assign pagination_sm = false
            assign pagination_lg = true
          elsif s.pagination_on == 'block lg:hidden'
            assign pagination_sm = true
            assign pagination_lg = false
          endif
        endif
        
        if s.type == 'slide' and s.loop
          assign type = 'loop'
        endif
      -%}

      {
        "settings": {},
        "config": {
          "type": {{ type | json }},
          {% if s.type == 'fade' and s.loop -%}
          "rewind": true,
          {%- endif %}
          "autoplay": {{ s.autoplay }},
          {% if s.autoplay -%}
          "interval": {{ s.interval }},
          "speed": {{ s.speed }},
          {%- endif %}
          "arrows": {{ arrows_sm }},
          "pagination": {{ pagination_sm }},
          {% if arrows_lg or pagination_lg -%}
          "breakpoints": {
            "1024": {
              {% if arrows_lg -%}
              "arrows": {{ arrows_lg }},
              {%- endif %}
              {% if pagination_lg -%}
              "pagination": {{ pagination_lg }}
              {% endif %}
            }
          }
          {%- endif %}
        }
      }
    </script>
  </slider-ui>
</div>

{%- schema -%}
  {
    "name": "Product Media Carousel",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Carousel Setting"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ]
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay slider",
        "default": false
      },
      {
        "type": "range",
        "id": "interval",
        "label": "Duration",
        "default": 4000,
        "min": 250,
        "max": 9750,
        "step": 250,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Transition",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "autoplay_video",
        "label": "Autoplay video",
        "default": false
      },
      {
        "type": "header",
        "content": "Controls Settings"
      },
      {
        "type": "checkbox",
        "id": "show_arrows",
        "label": "Show arrows",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_pagination",
        "label": "Show pagination",
        "default": false
      },
      {
        "type": "select",
        "id": "arrows_on",
        "label": "Arrows on",
        "default": "block",
        "options": [
          { "value": "block", "label": "All" },
          { "value": "hidden lg:block", "label": "Desktop" },
          { "value": "block lg:hidden", "label": "Mobile" }
        ],
        "visible_if": "{{ block.settings.show_arrows }}"
      },
      {
        "type": "select",
        "id": "pagination_on",
        "label": "Pagination on",
        "default": "block",
        "options": [
          { "value": "block", "label": "All" },
          { "value": "hidden lg:block", "label": "Desktop" },
          { "value": "block lg:hidden", "label": "Mobile" }
        ],
        "visible_if": "{{ block.settings.show_pagination }}"
      },
      {
        "type": "header",
        "content": "Aspect Ratio"
      },
      {
        "type": "select",
        "id": "aspect_sm",
        "label": "Aspect ratio",
        "default": "16:9",
        "options": [
          { "value": "custom", "label": "Custom" },
          { "value": "square", "label": "Square" },
          { "value": "fill", "label": "Fill" },
          { "value": "2:1", "label": "2:1" },
          { "value": "3:2", "label": "3:2" },
          { "value": "4:3", "label": "4:3"},
          { "value": "5:4", "label": "5:4" },
          { "value": "6:5", "label": "6:5" },
          { "value": "7:6", "label": "7:6" },
          { "value": "8:7", "label": "8:7" },
          { "value": "9:8", "label": "9:8" },
          { "value": "10:9", "label": "10:9" },
          { "value": "16:9", "label": "16:9" },
          { "value": "21:9", "label": "21:9" },
          { "value": "32:9", "label": "32:9" }
        ]
      },
      {
        "type": "text",
        "id": "custom_aspect_sm",
        "label": "Custom aspect ratio",
        "default": "16:9",
        "info": "Enter aspect ratio as 'width:height' (e.g. '16:9')",
        "visible_if": "{{ block.settings.aspect_sm == 'custom' }}"
      },
      {
        "type": "radio",
        "id": "orientation_sm",
        "label": "Media orientation",
        "default": "horizontal",
        "options": [
          { "value": "vertical", "label": "Portrait" },
          { "value": "horizontal", "label": "Landscape" }
        ],
        "visible_if": "{{ block.settings.aspect_sm != 'custom' and block.settings.aspect_sm != 'square' and block.settings.aspect_sm != 'adapt' and block.settings.aspect_sm != 'fill' }}"
      },
      {
        "type": "checkbox",
        "id": "enable_aspect_lg",
        "label": "Enable different aspect ratio for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "aspect_lg",
        "label": "Aspect ratio (desktop)",
        "default": "16:9",
        "options": [
          { "value": "custom", "label": "Custom" },
          { "value": "square", "label": "Square" },
          { "value": "fill", "label": "Fill" },
          { "value": "2:1", "label": "2:1" },
          { "value": "3:2", "label": "3:2" },
          { "value": "4:3", "label": "4:3"},
          { "value": "5:4", "label": "5:4" },
          { "value": "6:5", "label": "6:5" },
          { "value": "7:6", "label": "7:6" },
          { "value": "8:7", "label": "8:7" },
          { "value": "9:8", "label": "9:8" },
          { "value": "10:9", "label": "10:9" },
          { "value": "16:9", "label": "16:9" },
          { "value": "21:9", "label": "21:9" },
          { "value": "32:9", "label": "32:9" }
        ],
        "visible_if": "{{ block.settings.enable_aspect_lg }}"
      },
      {
        "type": "text",
        "id": "custom_aspect_lg",
        "label": "Custom aspect ratio (desktop)",
        "default": "16:9",
        "info": "Enter aspect ratio as 'width:height' (e.g. '16:9')",
        "visible_if": "{{ block.settings.enable_aspect_lg and block.settings.aspect_lg == 'custom' }}"
      },
      {
        "type": "radio",
        "id": "orientation_lg",
        "label": "Media orientation (desktop)",
        "default": "horizontal",
        "options": [
          { "value": "vertical", "label": "Portrait" },
          { "value": "horizontal", "label": "Landscape" }
        ],
        "visible_if": "{{ block.settings.enable_aspect_lg and block.settings.aspect_lg != 'custom' and block.settings.aspect_lg != 'square' and block.settings.aspect_lg != 'adapt' and block.settings.aspect_lg != 'fill' }}"
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Product Media Carousel",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}