{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'block-type'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  # Statically Rendered Block Props
  # theme-check-disable UndefinedObject
  assign item = item
  # theme-check-enable UndefinedObject

  assign resource = item | default: closest.product | default: product
-%}

{%- capture classlist -%}
  theme-block {{ classname }}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  {%- content_for 'blocks', closest.product: resource -%}
</div>

{%- schema -%}
  {
    "name": "Product Detail",
    "tag": null,
    "settings": [],
    "blocks": [
      { "type": "_product-description" },
      { "type": "_product-price" },
      { "type": "_product-sku" },
      { "type": "_product-tags" },
      { "type": "_product-title" },
      { "type": "_theme-breadcrumbs" }
    ],
    "presets": [
      {
        "name": "Product Detail",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}