{%- liquid
  assign s = block.settings
  assign resource = closest.product | default: product
-%}

{%- capture slider_slides -%}
  {% for item in resource.media %}
    <li class="splide__slide" ref="[]$PREFIX$-slide">
      <div class="slider-image__wrapper">
        <div class="slider-image__inner">
          {{ item.media_type }}
          {%- case item.media_type -%}
            {%- when 'image' -%}
              {{ item
                | image_url: width: item.width
                | image_tag: class: 'w-full h-full object-$IMAGE_FIT$'
              }}
            {%- when 'video' -%}
            {%- when 'external_video' -%}
          {%- endcase -%}
        </div>
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture main_slides -%}
  {{ slider_slides | replace: '$PREFIX$', 'main' | replace: '$IMAGE_FIT$', 'cover' }}
{%- endcapture -%}

<div {% render 'block.attributes' %}>
  <slider-ui
    data-section-id="{{ section.id }}"
    data-slider-navigation=""
    data-slider-modal=""
  >
    {%- render 'component.slider',
      prefix: 'main',
      slides: main_slides
    -%}

    <script type="application/json" ref="main-config">
      {{ block.settings | json }}
    </script>
  </slider-ui>
</div>

{%- schema -%}
  {
    "name": "Product Slider",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Main Settings"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ]
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay slider",
        "default": false
      },
      {
        "type": "range",
        "id": "interval",
        "label": "Duration",
        "default": 4000,
        "min": 250,
        "max": 9750,
        "step": 250,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Transition",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "autoplay_video",
        "label": "Autoplay video",
        "default": false
      },
      {
        "type": "header",
        "content": "Control Settings"
      },
      {
        "type": "select",
        "id": "arrows_sm",
        "label": "Arrow visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "pagination_sm",
        "label": "Pagination visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "checkbox",
        "id": "enable_controls_lg",
        "label": "Show separate settings for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "arrows_lg",
        "label": "Arrow visibility (desktop)",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ],
        "visible_if": "{{ block.settings.enable_controls_lg }}"
      },
      {
        "type": "select",
        "id": "pagination_lg",
        "label": "Pagination visibility (desktop)",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ],
        "visible_if": "{{ block.settings.enable_controls_lg }}"
      },
      {
        "type": "header",
        "content": "Additional Modules"
      },
      {
        "type": "checkbox",
        "id": "show_slider_nav",
        "label": "Show slider nav",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_slider_modal",
        "label": "Show slider modal",
        "default": false
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Product Slider",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}