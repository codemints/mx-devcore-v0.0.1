{%- liquid
  assign s = block.settings
  assign resource = closest.product | default: product

  assign arrows_sm = 'hidden'
  assign pagination_sm = 'hidden'

  assign arrows_lg = 'lg:hidden'
  assign pagination_lg = 'lg:hidden'

  if s.arrows_sm
    assign arrows_sm = 'block'
  endif

  if s.pagination_sm
    assign pagination_sm = 'block'
  endif

  if s.arrow_lg
    assign arrows_lg = 'lg:block'
  endif

  if s.pagination_lg
    assign pagination_lg = 'lg:block'
  endif
-%}

{%- capture arrows_classlist -%}
  {{ arrows_sm }}{% if s.enable_controls_lg %} {{ arrows_lg }}{% endif %}
{%- endcapture -%}

{%- capture pagination_classlist -%}
  {{ pagination_sm }}{% if s.enable_controls_lg %} {{ pagination_lg }}{% endif %}
{%- endcapture -%}

{%- comment -%} SLIDES {%- endcomment -%}
  {%- capture slider_slides -%}
    {% for item in resource.media %}
      <li class="splide__slide" ref="[]$PREFIX$-slide">
        <div class="slider-image__wrapper relative after:block after:pb-[100%]">
          <div class="slider-image__inner absolute">
            {%- case item.media_type -%}
              {%- when 'image' -%}
                {{ item
                  | image_url: width: item.width
                  | image_tag: class: 'w-full h-full object-$IMAGE_FIT$'
                }}
              {%- when 'video' -%}
                {{ item
                  | video_tag: class: 'w-full h-full object-$VIDEO_FIT$'
                }}
              {%- when 'external_video' -%}
            {%- endcase -%}
          </div>
        </div>
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  {%- capture main_slides -%}
    {{ slider_slides | replace: '$PREFIX$', 'main' | replace: '$IMAGE_FIT$', 'cover' | replace: '$VIDEO_FIT$', 'cover' }}
  {%- endcapture -%}

  {%- capture navigation_slides -%}
    {{ slider_slides | replace: '$PREFIX$', 'navigation' | replace: '$IMAGE_FIT$', 'cover' | replace: '$VIDEO_FIT$', 'cover' }}
  {%- endcapture -%}

  {%- capture modal_slides -%}
    {{ slider_slides | replace: '$PREFIX$', 'modal' | replace: '$IMAGE_FIT$', 'cover' | replace: '$VIDEO_FIT$', 'cover' }}
  {%- endcapture -%}
{%- comment -%} END {%- endcomment -%}

{%- comment -%} ASPECT RATIO {%- endcomment -%}
  {%- capture aspect_padding_sm -%}
    {%- render 'u.aspect-padding',
      ratio: s.aspect_sm,
      custom: s.custom_aspect_sm,
      orientation: s.orientation_sm,
      overlay: s.section_overlay_header
    -%}
  {%- endcapture -%}

  {%- if s.aspect_lg_on == true -%}
    {%- capture aspect_padding_lg -%}
      {%- render 'u.aspect-padding',
        ratio: s.aspect_lg,
        custom: s.custom_aspect_lg,
        orientation: s.orientation_lg,
        overlay: s.section_overlay_header
      -%}
    {%- endcapture -%}
  {%- endif -%}
{%- comment -%} END {%- endcomment -%}

{%- comment -%} SECTION STYLES {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --aspect-ratio-padding: {{ aspect_padding_sm }};

      {% if s.aspect_lg_on == true -%}
        @media only screen and (min-width: 1024px) {
          --aspect-ratio-padding: {{ aspect_padding_lg }};
        }
      {%- endif %}
    }
  {%- endstyle -%}
{%- comment -%} END {%- endcomment -%}

<div {% render 'block.attributes' %}>
  <slider-ui data-section-id="{{ section.id }}">
    {%- render 'component.slider',
      prefix: 'main',
      slides_html: main_slides,
      arrows_classlist: arrows_classlist
      pagination_classlist: pagination_classlist
    -%}

    {%- if s.show_slider_navigation -%}
      {%- content_for 'block', type: '_slider-navigation', id: 'product_slider_navigation', slides: navigation_slides -%}
    {%- endif -%}

    {%- if s.show_slider_modal -%}
      {%- content_for 'block', type: '_slider-modal', id: 'product_slider_modal', slides: modal_slides -%}
    {%- endif %}

    <script type="application/json" ref="main-slider-config">
      {{ s | json }}
    </script>
  </slider-ui>
</div>

{%- schema -%}
  {
    "name": "Product Slider",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Main Settings"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ]
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay slider",
        "default": false
      },
      {
        "type": "range",
        "id": "interval",
        "label": "Duration",
        "default": 4000,
        "min": 250,
        "max": 9750,
        "step": 250,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Transition",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "autoplay_video",
        "label": "Autoplay video",
        "default": false
      },
      {
        "type": "header",
        "content": "Control Settings"
      },
      {
        "type": "select",
        "id": "arrows_sm",
        "label": "Arrow visibility",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "pagination_sm",
        "label": "Pagination visibility",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ]
      },
      {
        "type": "checkbox",
        "id": "enable_controls_lg",
        "label": "Show separate settings for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "arrows_lg",
        "label": "Arrow visibility (desktop)",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ],
        "visible_if": "{{ block.settings.enable_controls_lg }}"
      },
      {
        "type": "select",
        "id": "pagination_lg",
        "label": "Pagination visibility (desktop)",
        "default": "false",
        "options": [
          { "value": "true", "label": "Show" },
          { "value": "false", "label": "Hide" }
        ],
        "visible_if": "{{ block.settings.enable_controls_lg }}"
      },
      {
        "type": "header",
        "content": "Aspect Ratio"
      },
      {
        "type": "select",
        "id": "aspect_sm",
        "label": "Aspect ratio",
        "default": "16:9",
        "options": [
          { "value": "custom", "label": "Custom" },
          { "value": "square", "label": "Square" },
          { "value": "fill", "label": "Fill" },
          { "value": "2:1", "label": "2:1" },
          { "value": "3:2", "label": "3:2" },
          { "value": "4:3", "label": "4:3"},
          { "value": "5:4", "label": "5:4" },
          { "value": "6:5", "label": "6:5" },
          { "value": "7:6", "label": "7:6" },
          { "value": "8:7", "label": "8:7" },
          { "value": "9:8", "label": "9:8" },
          { "value": "10:9", "label": "10:9" },
          { "value": "16:9", "label": "16:9" },
          { "value": "21:9", "label": "21:9" },
          { "value": "32:9", "label": "32:9" }
        ]
      },
      {
        "type": "text",
        "id": "custom_aspect_sm",
        "label": "Custom aspect ratio",
        "default": "16:9",
        "info": "Enter aspect ratio as 'width:height' (e.g. '16:9')",
        "visible_if": "{{ section.settings.aspect_sm == 'custom' }}"
      },
      {
        "type": "radio",
        "id": "orientation_sm",
        "label": "Media orientation",
        "default": "horizontal",
        "options": [
          { "value": "vertical", "label": "Portrait" },
          { "value": "horizontal", "label": "Landscape" }
        ],
        "visible_if": "{{ section.settings.aspect_sm != 'custom' and section.settings.aspect_sm != 'square' and section.settings.aspect_sm != 'adapt' and section.settings.aspect_sm != 'fill' }}"
      },
      {
        "type": "checkbox",
        "id": "aspect_lg_on",
        "label": "Enable different aspect ratio for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "aspect_lg",
        "label": "Aspect ratio (desktop)",
        "default": "16:9",
        "options": [
          { "value": "custom", "label": "Custom" },
          { "value": "square", "label": "Square" },
          { "value": "fill", "label": "Fill" },
          { "value": "2:1", "label": "2:1" },
          { "value": "3:2", "label": "3:2" },
          { "value": "4:3", "label": "4:3"},
          { "value": "5:4", "label": "5:4" },
          { "value": "6:5", "label": "6:5" },
          { "value": "7:6", "label": "7:6" },
          { "value": "8:7", "label": "8:7" },
          { "value": "9:8", "label": "9:8" },
          { "value": "10:9", "label": "10:9" },
          { "value": "16:9", "label": "16:9" },
          { "value": "21:9", "label": "21:9" },
          { "value": "32:9", "label": "32:9" }
        ],
        "visible_if": "{{ section.settings.aspect_lg_on == true }}"
      },
      {
        "type": "text",
        "id": "custom_aspect_lg",
        "label": "Custom aspect ratio (desktop)",
        "default": "16:9",
        "info": "Enter aspect ratio as 'width:height' (e.g. '16:9')",
        "visible_if": "{{ section.settings.aspect_lg_on == true and section.settings.aspect_lg == 'custom' }}"
      },
      {
        "type": "radio",
        "id": "orientation_lg",
        "label": "Media orientation (desktop)",
        "default": "horizontal",
        "options": [
          { "value": "vertical", "label": "Portrait" },
          { "value": "horizontal", "label": "Landscape" }
        ],
        "visible_if": "{{ section.settings.aspect_lg_on == true and section.settings.aspect_lg != 'custom' and section.settings.aspect_lg != 'square' and section.settings.aspect_lg != 'adapt' and section.settings.aspect_lg != 'fill' }}"
      },
      {
        "type": "header",
        "content": "Additional Modules"
      },
      {
        "type": "checkbox",
        "id": "show_slider_navigation",
        "label": "Show slider navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_slider_modal",
        "label": "Show slider modal",
        "default": false
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Product Slider",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}