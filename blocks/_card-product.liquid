{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = 'theme-block__' | append: unique_id

  assign resource = s.product | default: closest.product | default: product
-%}

<div id="{{ id }}" class="theme-block theme-block__product-card" {{ attrs }}>

</div>

{%- schema -%}
  {
    "name": "Product Card",
    "tag": null,
    "settings": [
      {
        "type": "product",
        "id": "product",
        "label": "Product"
      }
    ],
    "presets": [
      {
        "name": "Product Card",
        "settings": {},
        "blocks": [],
        "category": "Card"
      }
    ]
  }
{%- endschema -%}