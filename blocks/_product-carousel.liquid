{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'product-carousel'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  assign resource = closest.product | default: product

  assign show_arrows_sm = false
  assign show_pagination_sm = false

  if s.arrows_sm == 'show'
    assign show_arrows_sm = true
  endif

  if s.pagination_sm == 'show'
    assign show_pagination_sm = true
  endif
-%}

{%- capture classlist -%}
  theme-block {{ classname }}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  <carousel
    data-splide-config='{
      "type": "{{ s.type }}",
      "loop": {{ s.loop }},
      "autoplay": {{ s.autoplay }},
      "interval": {{ s.interval }},
      "speed": {{ s.speed }},
      "perPage": {{ s.per_page_sm }},
      "gap": {{ s.gap_sm }},
      "arrows": {{ show_arrows_sm }},
      "pagination": {{ show_pagination_sm }},
      "breakpoints": {
        "1024": {
        
        }
      }
    }'
  >

  </carousel>
</div>

{%- schema -%}
  {
    "name": "Product Carousel",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Main Settings"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ]
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "range",
        "id": "interval",
        "label": "Duration",
        "default": 4000,
        "min": 250,
        "max": 9750,
        "step": 250,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay == true }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Transition",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay == true }}"
      },
      {
        "type": "header",
        "content": "Thumbnail Settings"
      },
      {
        "type": "select",
        "id": "position_sm",
        "label": "Position",
        "default": "bottom",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ]
      },
      {
        "type": "range",
        "id": "per_page_sm",
        "label": "Per page",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1
      },
      {
        "type": "range",
        "id": "gap_sm",
        "label": "Gap",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "enable_thumbnail_lg",
        "label": "Enable desktop settings",
        "default": false
      },
      {
        "type": "select",
        "id": "position_lg",
        "label": "Position (desktop)",
        "default": "bottom",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ],
        "visible_if": "{{ block.settings.enable_thumbnail_lg == true }}"
      },
      {
        "type": "range",
        "id": "per_page_lg",
        "label": "Per page (desktop)",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1,
        "visible_if": "{{ block.settings.enable_thumbnail_lg == true }}"
      },
      {
        "type": "range",
        "id": "gap_lg",
        "label": "Gap (desktop)",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "visible_if": "{{ block.settings.enable_thumbnail_lg == true }}"
      },
      {
        "type": "header",
        "content": "Arrow Settings"
      },
      {
        "type": "select",
        "id": "arrows_sm",
        "label": "Mobile arrow visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "arrows_lg",
        "label": "Desktop arrow visibility",
        "default": "show",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "header",
        "content": "Pagination Settings"
      },
      {
        "type": "select",
        "id": "pagination_sm",
        "label": "Mobile pagination visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "pagination_lg",
        "label": "Desktop pagination visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Product Carousel",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}