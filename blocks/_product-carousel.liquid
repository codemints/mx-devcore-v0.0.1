        "default": "mt-0",
        "options": [
          { "value": "mt-0", "label": "None" },
          { "value": "mt-1", "label": "4px" },
          { "value": "mt-2", "label": "8px" },
          { "value": "mt-2.5", "label": "10px" },
          { "value": "mt-3", "label": "12px" },
          { "value": "mt-4", "label": "16px" },
          { "value": "mt-5", "label": "20px" },
          { "value": "mt-6", "label": "24px" },
          { "value": "mt-7", "label": "28px" },
          { "value": "mt-8", "label": "32px" },
          { "value": "mt-9", "label": "36px" },
          { "value": "mt-10", "label": "40px" },
          { "value": "mt-11", "label": "44px" },
          { "value": "mt-12", "label": "48px" },
          { "value": "mt-13", "label": "54px" },
          { "value": "mt-15", "label": "60px" },
          { "value": "mt-16", "label": "64px" },
          { "value": "mt-18", "label": "72px" },
          { "value": "mt-21", "label": "84px" },
          { "value": "mt-24", "label": "96px" },
