{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'product-carousel'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  assign resource = closest.product | default: product
-%}

{%- capture classlist -%}
  theme-block {{ classname }}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  
</div>

{%- schema -%}
  {
    "name": "Product Carousel",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Main Settings"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ]
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "range",
        "id": "interval",
        "label": "Duration",
        "default": 4000,
        "min": 250,
        "max": 9750,
        "step": 250,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay == true }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Transition",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay == true }}"
      },
      {
        "type": "header",
        "content": "Thumbnail Settings"
      },
      {
        "type": "select",
        "id": "position_sm",
        "label": "Position",
        "default": "bottom",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ]
      },
      {
        "type": "range",
        "id": "per_page_sm",
        "label": "Per page",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1
      },
      {
        "type": "range",
        "id": "gap_sm",
        "label": "Gap",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "enable_thumbnail_lg",
        "label": "Enable desktop settings",
        "default": false
      },
      {
        "type": "select",
        "id": "position_lg",
        "label": "Position (desktop)",
        "default": "bottom",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ]
      },
      {
        "type": "range",
        "id": "per_page_lg",
        "label": "Per page (desktop)",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1
      },
      {
        "type": "range",
        "id": "gap_lg",
        "label": "Gap (desktop)",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "header",
        "content": "Arrow Settings"
      },
      {
        "type": "select",
        "id": "arrows_sm",
        "label": "Mobile arrow visibility",
        "default": "hidden",
        "options": [
          { "value": "flex", "label": "Show" },
          { "value": "hidden", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "arrows_lg",
        "label": "Desktop arrow visibility",
        "default": "lg:hidden",
        "options": [
          { "value": "lg:flex", "label": "Show" },
          { "value": "lg:hidden", "label": "Hide" }
        ]
      },
      {
        "type": "header",
        "content": "Pagination Settings"
      },
      {
        "type": "select",
        "id": "pagination_sm",
        "label": "Mobile pagination visibility",
        "default": "hidden",
        "options": [
          { "value": "flex", "label": "Show" },
          { "value": "hidden", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "pagination_lg",
        "label": "Desktop pagination visibility",
        "default": "lg:hidden",
        "options": [
          { "value": "lg:flex", "label": "Show" },
          { "value": "lg:hidden", "label": "Hide" }
        ]
      },
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Product Carousel",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}