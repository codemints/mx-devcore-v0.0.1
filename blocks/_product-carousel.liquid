      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay slider",
        "default": false
      },
      {
        "type": "range",
        "id": "interval",
        "label": "Duration",
        "default": 4000,
        "min": 250,
        "max": 9750,
        "step": 250,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Transition",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "autoplay_video",
        "label": "Autoplay video",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_slider_nav",
        "label": "Enable thumbnail navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_slider_mod",
        "label": "Enable slider modal",
        "default": false
