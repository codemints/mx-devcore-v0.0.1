{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'product-carousel'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  assign resource = closest.product | default: product

  assign show_arrows_sm = false
  assign show_arrows_lg = false

  assign show_pagination_sm = false
  assign show_pagination_lg = false

  if s.arrows_sm == 'show'
    assign show_arrows_sm = true
  endif

  if s.arrows_lg == 'show'
    assign show_arrows_lg = true
  endif

  if s.pagination_sm == 'show'
    assign show_pagination_sm = true
  endif

  if s.pagination_lg == 'show'
    assign show_pagination_lg = true
  endif
-%}

{%- capture classlist -%}
  theme-block {{ classname }}
{%- endcapture -%}

{%- capture product_media -%}
  {%- for item in resource.media -%}
    <li class="splide__slide" ref="[]$PREFIX-slide">
      <div class="product-media__wrapper h-full">
        <div class="product-media__inner h-full">
          {%- case item.media_type -%}
            {%- when 'image' -%}
              {{ item 
                | image_url: width: item.width
                | image_tag: class: 'w-full h-full object-$IMAGE_FIT'
              }}
            {%- when 'video' -%}
              {{  item
                | video_tag
              }}
            {%- when 'external_video' -%}
              {{ item 
                | external_video_url: color: 'white'
                | external_video_tag: class: 'w-full h-full object-$VIDEO_FIT'
              }}
          {%- endcase -%}
        </div>
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture main_slides -%}
  {{ product_media | replace: '$PREFIX', 'slider' | replace: '$IMAGE_FIT', 'contain' | replace: '$VIDEO_FIT', 'contain' }}
{%- endcapture -%}

{%- capture nav_slides -%}
  {{ product_media | replace: '$PREFIX', 'nav-slider' | replace: '$IMAGE_FIT', 'cover' | replace: '$VIDEO_FIT', 'cover' }}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  <slider-ui
    data-section-id="{{ section.id }}"
    data-slider-enable-nav="{{ s.enable_slider_nav }}"
    data-slider-enable-mod="{{ s.enable_slider_mod }}"
  >
    {%- render 'component.slider',
      slides_markup: main_slides
    -%}

    {%- if s.enable_slider_nav -%}
      {%- render 'component.slider',
        prefix: 'slider-nav'
        slides_markup: nav_slides
      -%}
    {%- endif -%}

    <script type="application/json" ref="slider-config">
      {
        "type": {{ s.type | json }},
        "loop": {{ s.loop }},
        "autoplay": {{ s.autoplay }},
        "interval": {{ s.interval }},
        "speed": {{ s.speed }},
        "arrows": {{ show_arrows_sm }},
        "pagination": {{ show_pagination_sm }},
        "breakpoints": {
          "1024": {
            "arrows": {{ show_arrows_lg }},
            "pagination": {{ show_pagination_lg }}
          }
        }
      }
    </script>

    {%- if s.enable_slider_nav -%}
      <script type="application/json" ref="slider-nav-config">
      {
        "perPage": {{ s.per_page_sm }},
        "gap": {{ s.gap_sm }},
        "breakpoints": {
          "1024": {
            "perPage": {{ s.per_page_lg }},
            "gap": {{ s.gap_lg }}
          }
        }
      }
      </script>
    {%- endif -%}

    {%- if s.enable_slider_mod -%}
      <script type="application/json" ref="slider-mod-config">
        {}
      </script>
    {%- endif -%}
  </slider-ui>
</div>

{%- schema -%}
  {
    "name": "Product Carousel",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Main Settings"
      },
      {
        "type": "select",
        "id": "type",
        "label": "Slide type",
        "default": "slide",
        "options": [
          { "value": "slide", "label": "Slide" },
          { "value": "fade", "label": "Fade" }
        ]
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "range",
        "id": "interval",
        "label": "Duration",
        "default": 4000,
        "min": 250,
        "max": 9750,
        "step": 250,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Transition",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "unit": "ms",
        "visible_if": "{{ block.settings.autoplay }}"
      },
      {
        "type": "checkbox",
        "id": "enable_slider_nav",
        "label": "Enable thumbnail navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_slider_mod",
        "label": "Enable slider modal",
        "default": false
      },
      {
        "type": "header",
        "content": "Thumbnail Settings",
        "visible_if": "{{ block.settings.enable_slider_nav }}"
      },
      {
        "type": "select",
        "id": "position_sm",
        "label": "Position",
        "default": "bottom",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ],
        "visible_if": "{{ block.settings.enable_slider_nav }}"
      },
      {
        "type": "range",
        "id": "per_page_sm",
        "label": "Per page",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1,
        "visible_if": "{{ block.settings.enable_slider_nav }}"
      },
      {
        "type": "range",
        "id": "gap_sm",
        "label": "Gap",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "visible_if": "{{ block.settings.enable_slider_nav }}"
      },
      {
        "type": "checkbox",
        "id": "enable_nav_lg",
        "label": "Enable desktop settings",
        "default": false,
        "visible_if": "{{ block.settings.enable_slider_nav }}"
      },
      {
        "type": "select",
        "id": "position_lg",
        "label": "Position (desktop)",
        "default": "bottom",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "bottom", "label": "Bottom" },
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ],
        "visible_if": "{{ block.settings.enable_slider_nav and block.settings.enable_nav_lg }}"
      },
      {
        "type": "range",
        "id": "per_page_lg",
        "label": "Per page (desktop)",
        "default": 4,
        "min": 3,
        "max": 8,
        "step": 1,
        "visible_if": "{{ block.settings.enable_slider_nav and block.settings.enable_nav_lg }}"
      },
      {
        "type": "range",
        "id": "gap_lg",
        "label": "Gap (desktop)",
        "default": 10,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "visible_if": "{{ block.settings.enable_slider_nav and block.settings.enable_nav_lg }}"
      },
      {
        "type": "header",
        "content": "Modal Settings",
        "visible_if": "{{ block.settings.enable_slider_mod }}"
      },
      {
        "type": "header",
        "content": "Arrow Settings"
      },
      {
        "type": "select",
        "id": "arrows_sm",
        "label": "Mobile arrow visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "arrows_lg",
        "label": "Desktop arrow visibility",
        "default": "show",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "header",
        "content": "Pagination Settings"
      },
      {
        "type": "select",
        "id": "pagination_sm",
        "label": "Mobile pagination visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
      {
        "type": "select",
        "id": "pagination_lg",
        "label": "Desktop pagination visibility",
        "default": "hide",
        "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ]
      },
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Product Carousel",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}