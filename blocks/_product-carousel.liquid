{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'product-carousel'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  assign resource = closest.product | default: product

  assign show_arrows_sm = false
  assign show_arrows_lg = false

  assign show_pagination_sm = false
  assign show_pagination_lg = false

  if s.arrows_sm == 'show'
    assign show_arrows_sm = true
  endif

  if s.arrows_lg == 'show'
    assign show_arrows_lg = true
  endif

  if s.pagination_sm == 'show'
    assign show_pagination_sm = true
  endif

  if s.pagination_lg == 'show'
    assign show_pagination_lg = true
  endif
-%}

{%- capture classlist -%}
  theme-block {{ classname }}
{%- endcapture -%}

{%- capture product_media -%}
  {%- for item in resource.media -%}
    <li class="splide__slide" ref="[]$PREFIX-slide">
      <div class="product-media__wrapper h-full">
        <div class="product-media__inner h-full">
          {%- case item.media_type -%}
            {%- when 'image' -%}
              {{ item 
                | image_url: width: item.width
                | image_tag: class: 'w-full h-full object-$IMAGE_FIT'
              }}
            {%- when 'video' -%}
              {{  item
                | video_tag
              }}
            {%- when 'external_video' -%}
              {{ item 
                | external_video_url: color: 'white'
                | external_video_tag: class: 'w-full h-full object-$VIDEO_FIT'
              }}
          {%- endcase -%}
        </div>
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture main_slides -%}
  {{ product_media | replace: '$PREFIX', 'slider' | replace: '$IMAGE_FIT', 'contain' | replace: '$VIDEO_FIT', 'contain' }}
{%- endcapture -%}

{%- capture nav_slides -%}
  {{ product_media | replace: '$PREFIX', 'nav-slider' | replace: '$IMAGE_FIT', 'cover' | replace: '$VIDEO_FIT', 'cover' }}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  <slider-ui
    data-section-id="{{ section.id }}"
    data-slider-enable-nav="{{ s.enable_slider_nav }}"
    data-slider-enable-mod="{{ s.enable_slider_mod }}"
  >
    {%- render 'component.slider',
      slides_markup: main_slides
    -%}

    {%- if s.enable_slider_nav -%}
      <div class="product-carousel__nav {{ s.mt_sm }}{% if s.enable_mt_lg %} {{ s.mt_lg }}{% endif %}">
        {%- render 'component.slider',
          prefix: 'slider-nav'
          slides_markup: nav_slides
        -%}
      </div>
    {%- endif -%}

    <script type="application/json" ref="slider-config">
      {
        "type": {{ s.type | json }},
        "loop": {{ s.loop }},
        "autoplay": {{ s.autoplay }},
        "interval": {{ s.interval }},
        "speed": {{ s.speed }},
        "arrows": {{ show_arrows_sm }},
        "pagination": {{ show_pagination_sm }},
        "breakpoints": {
          "1024": {
            "arrows": {{ show_arrows_lg }},
            "pagination": {{ show_pagination_lg }}
          }
        }
      }
    </script>

    {%- if s.enable_slider_nav -%}
      <script type="application/json" ref="slider-nav-config">
      {
        "perPage": {{ s.nav_per_page_sm }},
        "gap": {{ s.nav_gap_sm }},
        "breakpoints": {
          "1024": {
            "perPage": {{ s.nav_per_page_lg }},
            "gap": {{ s.nav_gap_lg }}
          }
        }
      }
      </script>
    {%- endif -%}

    {%- if s.enable_slider_mod -%}
      <script type="application/json" ref="slider-mod-config">
      {
        "perPage": {{ s.mod_per_page_sm }},
        "gap": {{ s.mod_gap_sm }},
        "breakpoints": {
          "1024": {
            "perPage": {{ s.mod_per_page_lg }},
            "gap": {{ s.mod_gap_lg }}
          }
        }
      }
      </script>
    {%- endif -%}
  </slider-ui>
</div>

