{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'breadcrumbs'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type
-%}

{%- capture classlist -%}
theme-block {{ classname }} {{ s.mt_sm }}{% if s.enable_mt_lg %} {{ s.mt_lg }}{% endif %}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  <nav aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2 **:whitespace-nowrap">
      {%- unless s.show_advanced_settings == true and s.hide_root_url == true -%}
        <li class="flex items-center gap-2">
          <a href="{{ routes.root_url }}" class="block">Home</a>

          <span class="block size-1.5">
            {%- render 'icon-delimiter' -%}
          </span>
        </li>
      {%- endunless -%}

      {%- case template.name -%}
        {%- when 'page' -%}
          <li>{{ page.title }}</li>
        {%- when 'blog' -%}
          <li>{{ blog.title }}</li>

        {%- when 'article' -%}
          {%- liquid
            assign name = article.handle | split: '/' | first
          -%}

          <li class="flex items-center gap-2">
            <a href="{{ routes.root_url }}blogs/{{ name }}" class="block">{{ name | capitalize }}</a>

            <span class="block size-1.5">
              {%- render 'icon-delimiter' -%}
            </span>
          </li>

          <li>{{ article.title }}</li>

        {%- when 'collection' -%}
          {%- unless settings.hide_collections_list == true -%}
            <li class="flex items-center gap-2">
              <a href="{{ routes.collections_url }}" class="block">All Collections</a>

              <span class="block size-1.5">
                {%- render 'icon-delimiter' -%}
              </span>
            </li>
          {%- endunless -%}

          <li>
            {%- if collection.handle == 'all' -%}
              All Products
            {%- else -%}
              {{ collection.title }}
            {%- endif -%}
          </li>

        {%- when 'product' -%}
          {% if s.show_advanced_settings == true and s.collection_link != 'none' %}
            {%- liquid
              assign text = 'All Products'
              assign url = routes.all_products_collection_url

              if s.collection_link == 'custom' and s.collection_url != blank
                assign text = s.collection_url | split: '/' | last | capitalize
                assign url = s.collection_url
              endif
            -%}

            <li class="flex items-center gap-2">
              <a href="{{ url }}" class="block">{{ text }}</a>

              <span class="block size-1.5">
                {%- render 'icon-delimiter' -%}
              </span>
            </li>
          {%- endif -%}

          <li>
            {{ product.title }}
          </li>

      {%- endcase -%}
    </ol>
  </nav>
</div>

{%- schema -%}
  {
    "name": "Breadcrumbs",
    "tag": null,
    "settings": [
      {
        "type": "header",
        "content": "Block Settings"
      },
      {
        "type": "select",
        "id": "mt_sm",
        "label": "Space above",
        "default": "mt-0",
        "options": [
          { "value": "mt-0", "label": "None" },
          { "value": "mt-1", "label": "4px" },
          { "value": "mt-2", "label": "8px" },
          { "value": "mt-2.5", "label": "10px" },
          { "value": "mt-3", "label": "12px" },
          { "value": "mt-4", "label": "16px" },
          { "value": "mt-5", "label": "20px" },
          { "value": "mt-6", "label": "24px" },
          { "value": "mt-7", "label": "28px" },
          { "value": "mt-8", "label": "32px" },
          { "value": "mt-9", "label": "36px" },
          { "value": "mt-10", "label": "40px" },
          { "value": "mt-11", "label": "44px" },
          { "value": "mt-12", "label": "48px" },
          { "value": "mt-13", "label": "54px" },
          { "value": "mt-15", "label": "60px" },
          { "value": "mt-16", "label": "64px" },
          { "value": "mt-18", "label": "72px" },
          { "value": "mt-21", "label": "84px" },
          { "value": "mt-24", "label": "96px" },
          { "value": "mt-25", "label": "100px" }
        ]
      },
      {
        "type": "checkbox",
        "id": "enable_mt_lg",
        "label": "Show spacing settings for desktop",
        "default": false
      },
      {
        "type": "select",
        "id": "mt_lg",
        "label": "Space above (desktop)",
        "default": "lg:mt-0",
        "options": [
          { "value": "lg:mt-0", "label": "None" },
          { "value": "lg:mt-1", "label": "4px" },
          { "value": "lg:mt-2", "label": "8px" },
          { "value": "lg:mt-2.5", "label": "10px" },
          { "value": "lg:mt-3", "label": "12px" },
          { "value": "lg:mt-4", "label": "16px" },
          { "value": "lg:mt-5", "label": "20px" },
          { "value": "lg:mt-6", "label": "24px" },
          { "value": "lg:mt-7", "label": "28px" },
          { "value": "lg:mt-8", "label": "32px" },
          { "value": "lg:mt-9", "label": "36px" },
          { "value": "lg:mt-10", "label": "40px" },
          { "value": "lg:mt-11", "label": "44px" },
          { "value": "lg:mt-12", "label": "48px" },
          { "value": "lg:mt-13", "label": "54px" },
          { "value": "lg:mt-15", "label": "60px" },
          { "value": "lg:mt-16", "label": "64px" },
          { "value": "lg:mt-18", "label": "72px" },
          { "value": "lg:mt-21", "label": "84px" },
          { "value": "lg:mt-24", "label": "96px" },
          { "value": "lg:mt-25", "label": "100px" }
        ],
        "visible_if": "{{ block.settings.enable_mt_lg == true }}"
      },
      {
        "type": "checkbox",
        "id": "show_advanced_settings",
        "label": "Show advanced settings",
        "default": false
      },
      {
        "type": "header",
        "content": "Advanced Settings",
        "visible_if": "{{ block.settings.show_advanced_settings == true }}"
      },
      {
        "type": "checkbox",
        "id": "hide_root_url",
        "label": "Hide home link",
        "default": false,
        "visible_if": "{{ block.settings.show_advanced_settings == true }}"
      },
      {
        "type": "select",
        "id": "collection_link",
        "label": "Collection link",
        "default": "all",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "all", "label": "All" },
          { "value": "custom", "label": "Custom" }
        ],
        "info": "Only applicable on product templates.",
        "visible_if": "{{ block.settings.show_advanced_settings == true }}"
      },
      {
        "type": "url",
        "id": "collection_url",
        "label": "Collection url",
        "visible_if": "{{ block.settings.show_advanced_settings == true and block.settings.collection_link == 'custom' }}"
      }
    ],
    "presets": [
      {
        "name": "Breadcrumbs",
        "settings": {},
        "blocks": [],
        "category": "Navigation"
      }
    ]
  }
{%- endschema -%}