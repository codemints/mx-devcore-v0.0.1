{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'add-to-cart'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  assign resource = s.product | default: closest.product | default: product
  assign current = resource.selected_or_first_available_variant
-%}

{%- capture classlist -%}
  theme-block {{ classname }}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  <div class="product-card__inner">
    <div class="product-card__media">
      {{ resource.featured_image
        | image_url: width: resource.featured_image.width
        | image_tag: class: 'cover-center'
      }}
    </div>

    <div class="product-card__details">
      <h4>{{ resource.title }}</h4>
      <p>{{ resource.price | money }}</p>
    </div>

    <div class="product-card__form">
      {%- form 'product', resource, id: '', class: '', mx-cart-add-form: '' -%}
      {%- endform -%}
    </div>
  </div>
</div>

{%- schema -%}
  {
    "name": "Product Card",
    "tag": null,
    "settings": [
      {
        "type": "product",
        "id": "product",
        "label": "Product"
      }
    ],
    "presets": [
      {
        "name": "Product Card",
        "settings": {},
        "blocks": [],
        "category": "Card"
      }
    ]
  }
{%- endschema -%}