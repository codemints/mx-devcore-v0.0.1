{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'price'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  assign resource = closest.product | default: product
  assign price = resource.price
  assign compare = resource.compare_at_price
  assign is_sale = false

  if compare != blank and compare > price
    assign is_sale = true
  endif
-%}

{%- capture classlist -%}
  theme-block {{ classname }}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
</div>

{%- schema -%}
  {
    "name": "Price",
    "tag": null,
    "settings": [],
    "presets": [
      {
        "name": "Price",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}