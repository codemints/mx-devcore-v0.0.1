{%- liquid
  assign s = block.settings
  assign attrs = block.shopify_attributes
  assign prefix = 'theme-block__'
  assign type = 'price'
  assign unique_id = section.id | append: '--' | append: block.id
  assign id = prefix | append: unique_id
  assign classname = prefix | append: type

  assign resource = closest.product | default: product
  assign sofav = resource.selected_or_first_available_variant
  assign selected = resource.selected_variant
  assign price = sofav.price
  assign compare = sofav.compare_at_price
  assign price_varies = resource.price_varies
  assign price_min = resource.price_min
  assign price_max = resource.price_max
  assign is_sale = false
  assign show_sale = false
  assign show_discount = false
  assign show_range = false
  assign discount_amount = 0

  if s.show_range and price_varies and selected == blank
    assign show_range = true
  endif

  if show_range == false and compare != blank and compare > price
    assign is_sale = true

    if is_sale == true and s.hide_sale_price == false
      assign show_sale = true
    endif

    if show_sale == true and s.show_discount == true
      assign show_discount = true

      if s.discount_type == 'percent'
        assign price_d = price | times: 1.0
        assign compare_d = compare | times: 1.0
        assign percent = price_d | divided_by: compare_d | round: 2 | times: 100 | round | minus: 100 | times: -1
        assign discount_amount = percent | append: '%'
      elsif s.discount_type == 'value'
        assign discount_amount = compare | minus: price | money
      endif
    endif
  endif
-%}

{%- capture classlist -%}
  theme-block {{ classname }} {{ s.mt_sm }}{% if s.enable_mt_lg %} {{ s.mt_lg }}{% endif %}
{%- endcapture -%}

<div id="{{ id }}" class="{{ classlist | strip }}" {{ attrs }}>
  <div class="product-price flex items-center gap-2">
    {%- if show_range == true -%}
      <span class="sr-only">From</span>
      <span data-price-min>{{ price_min | money }}</span>
      <span aria-hidden="true">–</span>
      <span class="sr-only">to</span>
      <span data-price-max>{{ price_max | money }}</span>

    {%- elsif show_sale == true -%}
      <span class="sr-only">Sale price</span>
      <span data-price-sale>{{ price | money }}</span>

      <span class="sr-only">Regular price</span>
      <s data-price-compare>{{ compare | money }}</s>

      {%- if show_discount == true -%}
        <span data-price-discount>{{ discount_amount }} off</span>
      {%- endif -%}

    {%- else -%}
      <span class="sr-only">Price</span>
      <span data-price-regular>{{ price | money }}</span>
    {%- endif -%}
  </div>
</div>

