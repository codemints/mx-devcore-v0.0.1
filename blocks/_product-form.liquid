{%- liquid
  assign s = block.settings
  assign resource = closest.product | default: product
-%}

<div {% render 'block.attributes' %}>
  {%- content_for 'blocks' -%}
</div>

{%- schema -%}
  {
    "name": "Product Form",
    "tag": null,
    "settings": [],
    "blocks": [
      { "type": "_product-subscriptions" },
      { "type": "_product-variant-selectors" }
    ],
    "presets": [
      {
        "name": "Product Form",
        "settings": {},
        "blocks": [],
        "category": "Product"
      }
    ]
  }
{%- endschema -%}