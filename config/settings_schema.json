[
  {
    "name": "theme_info",
    "theme_name": "MX DevCore",
    "theme_author": "moxiethunder",
    "theme_version": "0.0.1",
    "theme_documentation_url": "https:\/\/github.com\/codemints\/mx-devcore-v0.0.1\/",
    "theme_support_url": "https:\/\/github.com\/codemints\/mx-devcore-v0.0.1\/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_on_light",
        "label": "Logo for light surfaces"
      },
      {
        "type": "image_picker",
        "id": "logo_on_dark",
        "label": "Logo for dark surfaces"
      },
      {
        "type": "image_picker",
        "id": "logo_favicon",
        "label": "The site favicon"
      }
    ]
  },
  {
    "name": "Theme",
    "settings": [
      {
        "type": "textarea",
        "id": "font_embeds",
        "label": "Embedded fonts"
      },
      {
        "type": "textarea",
        "id": "scripts_head",
        "label": "Head scripts"
      },
      {
        "type": "textarea",
        "id": "scripts_body",
        "label": "Body scripts"
      },
      {
        "type": "textarea",
        "id": "scripts_footer",
        "label": "Footer scripts"
      },
      {
        "type": "checkbox",
        "id": "list_collections_hide",
        "label": "Hide list collections template",
        "default": false
      },
      {
        "type": "url",
        "id": "list_collections_redirect",
        "label": "Redirect list collections to",
        "visible_if": "{{ settings.list_collections_hide == true }}"
      }
    ]
  },
  {
    "name": "Menus",
    "settings": [
      {
        "type": "link_list",
        "id": "menu_primary",
        "label": "Primary navigation",
        "default": "main-menu",
        "info": "Used in the header as the primary navigation"
      },
      {
        "type": "link_list",
        "id": "menu_mobile",
        "label": "Mobile navigation",
        "info": "Used for mobile navigation drawer. Defaults to primary navigation if blank."
      },
      {
        "type": "link_list",
        "id": "menu_footer_legal",
        "label": "Legal navigation",
        "info": "Used in Footer Legal section."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "page",
        "options": [
          { "value": "page", "label": "Page" },
          { "value": "drawer", "label": "Drawer" }
        ]
      },
      {
        "type": "checkbox",
        "id": "cart_count_visible",
        "label": "Show cart count",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "cart_count_hide",
        "label": "Hide cart count when empty",
        "default": true,
        "visible_if": "{{ settings.cart_count_visible == true }}"
      }
    ]
  },
  {
    "name": "Cart Drawer",
    "settings": [
      {
        "type": "select",
        "id": "cart_drawer_layout",
        "label": "Layout",
        "default": "right",
        "options": [
          { "value": "right", "label": "Left" },
          { "value": "left", "label": "Right" }
        ],
        "visible_if": "{{ settings.cart_type == 'drawer' }}"
      },
      {
        "type": "select",
        "id": "cart_drawer_position",
        "label": "Position",
        "default": "over",
        "options": [
          { "value": "over", "label": "Over header" },
          { "value": "under", "label": "Under header" }
        ],
        "visible_if": "{{ settings.cart_type == 'drawer' }}"
      },
      {
        "type": "range",
        "id": "cart_drawer_width",
        "label": "Width",
        "default": 450,
        "min": 350,
        "max": 850,
        "step": 5,
        "unit": "px"
      },
    ]
  },
  {
    "name": "Developer",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_devmode",
        "label": "Enable developer mode",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_hot_reload",
        "label": "Enable hot reload",
        "default": false,
        "visible_if": "{{ settings.enable_devmode == true }}"
      }
    ]
  }
]