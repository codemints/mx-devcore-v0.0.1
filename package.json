{
  "name": "mx-devcore",
  "version": "0.0.1",
  "description": "A theme development framework for Shopify",
  "author": "moxiethunder",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0",
    "npm": ">=11.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 15",
    "Android >= 10"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --watch",
    "tailwind": "tailwindcss -i ./app/css/theme.css -o ./assets/theme.min.css --watch --minify",
    "shop:dev": "shopify theme dev -e development",
    "push:dev": "shopify theme push -e development",
    "start:dev": "run-p dev build tailwind shop:dev",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "vite": "^7.3.1",
    "vite-plugin-shopify": "^4.1.1",
    "vitepress": "^2.0.0-alpha.16",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "@tailwindcss/cli": "^4.1.18",
    "motion": "^12.33.0",
    "tailwindcss": "^4.1.18"
  }
}
